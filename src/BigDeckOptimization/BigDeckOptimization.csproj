<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>BigDeckOptimization</AssemblyName>
    <RootNamespace>BigDeckOptimization</RootNamespace>
    <!-- The game treats every .json in a mod folder as a manifest: never emit deps.json. -->
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- PDB inside the DLL (compressed): line numbers in error logs, one file less. -->
    <DebugType>embedded</DebugType>
    <!-- Keep in sync with "version" in BigDeckOptimization.json. -->
    <Version>0.7.0</Version>
  </PropertyGroup>

  <!-- Test tooling (bigdeck / bdperf console commands, combat start timer) only in non-Release builds. -->
  <PropertyGroup Condition="'$(Configuration)' != 'Release'">
    <DefineConstants>$(DefineConstants);BENCH</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <Compile Remove="Bench/**" />
  </ItemGroup>

  <!-- Public builds: no local paths in the DLL and its embedded PDB (source paths become /_/...). -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <PathMap>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../'))=/_/</PathMap>
  </PropertyGroup>

  <!-- GameDir comes from Directory.Build.props (override in Directory.Build.local.props). -->
  <PropertyGroup>
    <GameDataDir Condition="'$(GameDataDir)' == ''">$(GameDir)\data_sts2_windows_x86_64</GameDataDir>
    <ModDeployDir>$(GameDir)\mods\BigDeckOptimization</ModDeployDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="sts2" HintPath="$(GameDataDir)\sts2.dll" Private="false" />
    <Reference Include="GodotSharp" HintPath="$(GameDataDir)\GodotSharp.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(GameDataDir)\0Harmony.dll" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="BigDeckOptimization.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Shown on the mods screen (Patches/ModImage.cs). -->
    <None Include="mod_image.jpg" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Settings menu translations (Config/Translations.cs), one per game language code, inside the DLL: the game treats
       every .json in a mod folder as a manifest. -->
  <ItemGroup>
    <EmbeddedResource Include="Localization\*.json" LogicalName="BigDeckOptimization.Localization.%(Filename).json" />
  </ItemGroup>

  <!-- The settings menu DLL (the only one referencing BaseLib, which is optional): built next to this one. -->
  <Target Name="BuildMenu" AfterTargets="Build">
    <!-- Restore runs on its own (different global properties), as NuGet requires. -->
    <MSBuild Projects="..\BigDeckOptimization.Menu\BigDeckOptimization.Menu.csproj" Targets="Restore"
             Properties="Configuration=$(Configuration);MainDll=$(TargetPath);MenuRestore=true" />
    <MSBuild Projects="..\BigDeckOptimization.Menu\BigDeckOptimization.Menu.csproj" Targets="Build"
             Properties="Configuration=$(Configuration);MainDll=$(TargetPath)" />
  </Target>

  <Target Name="DeployToGame" AfterTargets="BuildMenu" Condition="'$(DeployToGame)' != 'false' And Exists('$(GameDir)')">
    <ItemGroup>
      <ModFiles Include="$(OutDir)BigDeckOptimization.dll;$(OutDir)BigDeckOptimization.json;$(OutDir)mod_image.jpg;$(OutDir)BigDeckOptimization.Menu.dll" />
    </ItemGroup>
    <!-- The game locks the DLL while running: warn instead of failing the build. -->
    <Copy SourceFiles="@(ModFiles)" DestinationFolder="$(ModDeployDir)" SkipUnchangedFiles="true" Retries="0" ContinueOnError="WarnAndContinue" />
    <Message Importance="high" Condition="'$(MSBuildLastTaskResult)' == 'true'" Text="BigDeckOptimization deployed to $(ModDeployDir)" />
    <Warning Condition="'$(MSBuildLastTaskResult)' != 'true'" Text="Deploy skipped: close Slay the Spire 2 and rebuild." />
  </Target>

</Project>
